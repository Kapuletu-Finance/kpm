# Copy to .env.local for local development.

# Application URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL 16 via Drizzle + node-postgres)
# Local: `npm run db:up` starts it on port 55432.
# Vercel: the PgBouncer URL, e.g. postgres://kpm:***@db.example.com:6432/kpm
#         (no ?sslmode param; TLS is configured in lib/db/index.ts)
DATABASE_URL=postgres://kpm:kpm@localhost:55432/kpm
# Direct connection (never PgBouncer) used by drizzle-kit and scripts.
# Production: through an SSH tunnel, e.g. postgres://kpm:***@localhost:15432/kpm
DATABASE_URL_DIRECT=postgres://kpm:kpm@localhost:55432/kpm

# Auth.js session encryption key: openssl rand -base64 32
AUTH_SECRET=

# Cloudinary (file uploads; only the returned URL is stored in Postgres)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Postmark (verification, invite, password reset and assignment emails).
# Leave empty locally: links are printed to the dev server console instead.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# One-off migration from Supabase only (scripts/db/import-from-supabase.sh, npm run db:introspect).
# Direct or session-pooler URL, port 5432.
SUPABASE_DB_URL=
