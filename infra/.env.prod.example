# Copy to infra/.env.prod on the VPS (gitignored) and fill in. Used by docker-compose.prod.yml.

# --- Database (always) ---
POSTGRES_USER=kpm
POSTGRES_DB=kpm
# URL-safe, since it is embedded in connection strings:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App on this VPS (--profile app) ---
# DNS A/AAAA record must point at this server; Caddy fetches the TLS certificate.
APP_DOMAIN=kpm.example.com
# openssl rand -base64 32
AUTH_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
